# =====================================================================
# Configuração local (copie para .env e ajuste).
# O docker-compose já injeta os mesmos valores por variável de ambiente.
# =====================================================================

# --- HTTP ---
PORT=3000
LOG_LEVEL=info

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=jungle
POSTGRES_PASSWORD=jungle
POSTGRES_DB=jungle

# --- AWS / SQS (LocalStack em desenvolvimento) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566

# --- Workers ---
# Intervalo do publisher da outbox (ms).
OUTBOX_POLL_INTERVAL_MS=500
# Tamanho do lote de eventos publicados por vez.
OUTBOX_BATCH_SIZE=20
# Lease da reserva de uma linha da outbox (segundos).
OUTBOX_LEASE_SECONDS=30
# Intervalo do worker de referências pendentes (ms).
PENDING_REFERENCE_INTERVAL_MS=5000
